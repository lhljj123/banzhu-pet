{
  "name": "banzhu-pet",
  "version": "1.1.0",
  "description": "一只会监督久坐、强制你按时休息的 Windows 桌面宠物",
  "main": "electron/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.banzhu.pet",
    "productName": "伴桌",
    "asar": true,
    "asarUnpack": [
      "electron/display-monitor.ps1"
    ],
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "electron/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
