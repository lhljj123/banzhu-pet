{
  "name": "banzhu-pet",
  "version": "2.3.1",
  "description": "一只会监督久坐、强制你按时休息的 Windows 桌面宠物",
  "main": "electron/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "build:renderer": "esbuild app.js --bundle --format=iife --platform=browser --outfile=app.bundle.js && esbuild electron/break.js --bundle --format=iife --platform=browser --outfile=electron/break.bundle.js",
    "prestart": "npm run build:renderer",
    "start": "electron .",
    "dev": "electron .",
    "predist": "npm run build:renderer",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.10"
  },
  "build": {
    "appId": "com.banzhu.pet",
    "productName": "伴桌",
    "asar": true,
    "asarUnpack": [
      "electron/display-monitor.ps1"
    ],
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "app.bundle.js",
      "electron/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "three": "^0.180.0"
  }
}
